---
import Layout from "../../layouts/Layout.astro";
import { loadDataset } from "../../lib/server/dataset";

const dataset = loadDataset();
const { manifest } = dataset;
---

<Layout title="About this data">
  <h1>About this data</h1>
  <p class="data-notice">{manifest.notice}</p>
  <dl>
    <div>
      <dt>Dataset</dt>
      <dd>{manifest.datasetId} (version {manifest.version})</dd>
    </div>
    <div>
      <dt>Kind</dt>
      <dd>
        {
          manifest.kind === "synthetic"
            ? "Synthetic — fabricated for this prototype, not a real ANU export"
            : "Verified — sourced from an ANU Web Publisher export"
        }
      </dd>
    </div>
    <div>
      <dt>Term</dt>
      <dd>{manifest.term}</dd>
    </div>
    <div>
      <dt>Timezone</dt>
      <dd>{manifest.timezone}</dd>
    </div>
    <div>
      <dt>Teaching weeks covered</dt>
      <dd>{manifest.teachingWeeks.join(", ")}</dd>
    </div>
    <div>
      <dt>Reviewed</dt>
      <dd>{manifest.reviewedAt} by {manifest.reviewedBy}</dd>
    </div>
    {
      manifest.sourceUrl && (
        <div>
          <dt>Source</dt>
          <dd>
            <a href={manifest.sourceUrl}>{manifest.sourceUrl}</a>
          </dd>
        </div>
      )
    }
  </dl>
  {manifest.notes && <p>{manifest.notes}</p>}
</Layout>
